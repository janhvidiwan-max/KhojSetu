{
  "name": "khojsetu",
  "version": "1.0.0",
  "description": "KhojSetu — Intelligent Missing Person Detection & Investigation System ('From Missing to Found.')",
  "main": "index.js",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ai": "cd ai-service && python main.py",
    "start": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "install:all": "cd frontend && npm install && cd ../backend && npm install",
    "seed": "npm --prefix backend run seed"
  },
  "keywords": [
    "khojsetu",
    "missing-person-detection",
    "ai-investigation",
    "computer-vision",
    "face-matching"
  ],
